{
  "name": "osteo-soft",
  "version": "0.3.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:api": "node server/index.mjs",
    "start:full": "concurrently -n web,api -c cyan,green \"npm:start\" \"npm:start:api\"",
    "seed:fakename": "node server/scripts/import-fakename-patients.mjs 1500",
    "seed:directory": "node server/scripts/seed-directory-contacts.mjs",
    "e2e:backup": "node server/scripts/e2e-backup-restore.mjs",
    "e2e:rights": "node server/scripts/e2e-access-rights.mjs",
    "test:api": "node --test server/test/*.test.mjs",
    "typecheck": "tsc -p server/tsconfig.json",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test --watch=false --browsers=ChromeHeadless",
    "test:watch": "ng test",
    "release": "standard-version",
    "release:patch": "standard-version --release-as patch",
    "release:minor": "standard-version --release-as minor",
    "release:major": "standard-version --release-as major"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^21.2.23",
    "@angular/compiler": "^21.2.23",
    "@angular/core": "^21.2.23",
    "@angular/forms": "^21.2.23",
    "@angular/localize": "^21.2.23",
    "@angular/platform-browser": "^21.2.23",
    "@angular/platform-browser-dynamic": "^21.2.23",
    "@angular/router": "^21.2.23",
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@ng-bootstrap/ng-bootstrap": "^20.0.0",
    "argon2": "^0.44.0",
    "better-sqlite3": "^12.9.0",
    "bootstrap": "^5.3.8",
    "bootstrap-datepicker": "^1.10.1",
    "chart.js": "^4.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "dompurify": "^3.4.1",
    "dotenv": "^17.4.2",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^8.3.2",
    "file-type": "^21.3.4",
    "helmet": "^8.1.0",
    "jquery": "^3.7.1",
    "jsonwebtoken": "^9.0.3",
    "jspdf": "^4.2.1",
    "jszip": "^3.10.1",
    "moment": "^2.29.4",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0",
    "zod": "^4.3.6",
    "zone.js": "^0.16.1"
  },
  "overrides": {
    "ip-address": "^10.2.0"
  },
  "devDependencies": {
    "@angular/build": "^21.2.24",
    "@angular/cli": "^21.2.24",
    "@angular/compiler-cli": "^21.2.23",
    "@types/bootstrap": "^5.2.10",
    "@types/jasmine": "^6.0.0",
    "@types/node": "^26.6.2",
    "concurrently": "^9.2.1",
    "jasmine-core": "^6.2.0",
    "karma": "^6.4.4",
    "karma-chrome-launcher": "^3.2.0",
    "karma-coverage": "^2.2.1",
    "karma-jasmine": "^5.1.0",
    "karma-jasmine-html-reporter": "^2.2.0",
    "prettier": "^3.8.1",
    "standard-version": "^9.5.0",
    "typescript": "~5.9.2"
  }
}
