# ─────────────────────────────────────────────────────────────
#  OsteoSoft — Exemple de fichier d'environnement
#  Copier ce fichier en .env et adapter les valeurs.
#  Ne jamais committer le fichier .env dans le dépôt Git.
# ─────────────────────────────────────────────────────────────

# ── Environnement ───────────────────────────────────────────

# NODE_ENV doit valoir 'development' pour AUTORISER les clés/secrets de dev par
# défaut. Toute autre valeur (production, staging, ou variable ABSENTE) est
# traitée comme un déploiement réel : l'API REFUSE alors de démarrer sans
# OSTEOSOFT_DATA_KEY et JWT_SECRET renseignés (garde-fou anti-secrets de dev).
NODE_ENV=development

# ── Sécurité obligatoire en production ──────────────────────

# Clé de chiffrement AES-256 pour les données sensibles (base64, 32 bytes).
# Générer avec : node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# IMPORTANT : conserver cette clé séparément des sauvegardes.
OSTEOSOFT_DATA_KEY=

# Secret JWT pour la signature des tokens de session.
# Générer avec : node -e "console.log(require('crypto').randomBytes(48).toString('base64'))"
JWT_SECRET=

# ── Réseau ──────────────────────────────────────────────────

# Port d'écoute de l'API (défaut : 4199).
API_PORT=4199

# Origine autorisée pour les requêtes CORS du frontend.
# En production, utiliser le domaine HTTPS complet (ex: https://osteosoft.example.com).
CLIENT_ORIGIN=http://localhost:4200

# Proxies de confiance pour X-Forwarded-For (true | 1 | loopback | false).
# Activer uniquement si l'API est derrière un reverse proxy (nginx, Traefik…).
TRUST_PROXY=false

# ── Taille des requêtes ──────────────────────────────────────

# Limite globale des corps de requête (défaut : 5mb).
# API_BODY_LIMIT=5mb

# Limite pour les routes volumineuses (import, restore, documents) (défaut : 60mb).
# API_LARGE_BODY_LIMIT=60mb

# Taille maximale d'un document patient en bytes (défaut : 15 728 640 = 15 Mo).
# MAX_PATIENT_DOCUMENT_BYTES=15728640

# ── Sessions ────────────────────────────────────────────────

# Durée de vie du JWT avec "Se souvenir de moi" (défaut : 12h).
# SESSION_REMEMBER_TTL=12h

# Durée de vie du JWT sans "Se souvenir de moi" (défaut : 2h).
# SESSION_DEFAULT_TTL=2h

# ── Rétention des données (RGPD) ─────────────────────────────

# Durée de conservation des logs d'audit en jours (défaut : 1095 = 3 ans).
# Mettre à 0 pour désactiver la purge automatique.
# AUDIT_LOG_RETENTION_DAYS=1095

# Durée de conservation des brouillons orphelins en jours (défaut : 7).
# DRAFT_RETENTION_DAYS=7

# ── Configuration initiale ───────────────────────────────────

# Autoriser l'accès distant au wizard de premier démarrage (false par défaut).
# Mettre à true uniquement lors du déploiement initial si l'accès localhost n'est pas possible.
# ALLOW_REMOTE_SETUP=false
