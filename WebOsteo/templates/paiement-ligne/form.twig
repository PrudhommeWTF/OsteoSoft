{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import input %}
{% from 'macros.twig' import checkbox %}

<div class="col-xs-12 nopadding">
    <div class="alert alert-info">Choisissez le mode d'envoi du lien de paiement au patient. Le paiement restant à régler
        {% if facture.id is not empty %}pour cette facture
            <b class="rose">{{ libelle_transaction }}</b> est de
            <b class="rose">{{ montant_net_regle }} {{ devise }}</b>.
        {% else %}
            pour ce rendez-vous
            <b class="rose">{{ libelle_transaction }}</b> est de
            <b class="rose">{{ montant_net_regle }} {{ devise }}</b>.
        {% endif %}

    </div>
</div>

<div class="form-group col-xs-12 nopadding">
    <label class="{{ label_class }}"> Montant du paiement à régler </label>
    <div class="{{ div_class }}">
        <input name="net_a_regler" class="form-control input-sm obligatoire" type="text"
               value="{{ montant_net_regle }}" style="width: 60px"> {{ devise}}
    </div>
</div>
{{ checkbox('ck_send_mail_facture','send_facture', '1', 'Envoyer la facture par mail <i class="fa fa-info-circle tooltipTop" title="Si vous cochez cette case, dès le paiement de la facture par le patient, celui-ci recevra un email de facture automatiquement."></i>',false, label_class ,div_class) }}

<div class="form-group col-xs-12 nopadding" id="partner-payment-container-email-{{ id_element }}">
    <label class="{{ label_class }}"> Email du client</label>
    <div class="{{ div_class }}">
        <input name="partner-payment-email" class="form-control input-sm" required type="text"
               value="{{ email_client }}">
    </div>
</div>

<div class="form-group col-xs-12 nopadding">
    <label class="{{ label_class }}"> Type d'envoi </label>
    <div class="{{ div_class }}">
        <select class="selectpicker" id="send_type-{{ id_element }}" name="send_type" data-width="100%"> </select>
    </div>
</div>

<div class="form-group col-xs-12 nopadding hidden" id="partner-payment-container-telephone-{{ id_element }}">
    <label class="{{ label_class }}"> Téléphone </label>
    <div class="{{ div_class }}">
        <input name="partner-payment-telephone" class="form-control input-sm" type="text"
               value="{{ telephone_client }}">
    </div>
</div>

<div class="col-xs-12 nopadding  paddingT20 paddingB20 partner-payment-actions hidden">
    <div class="col-xs-6 text-right">
        <button type="button" class="btn btn-warning text-left btn-partner-payment-cancel"
                data-facture="{{ id_element }}">
            <i class="fas fa-ban"></i> Annuler
        </button>
    </div>
    <div class="col-xs-6 text-left">
        <button type="button" class="btn btn-success text-right btn-partner-payment-save"
                data-facture="{{ id_element }}">
            <i class="fas fa-check"></i> Envoyer le lien
        </button>
    </div>
</div>


<div class="clear"></div>