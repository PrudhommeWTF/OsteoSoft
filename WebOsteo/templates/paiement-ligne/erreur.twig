{% if msg is not empty %}
    <b>L'erreur suivante a été rencontrée : </b>{{ msg }}
{% endif %}
{% if liste_erreurs|length>0 %}
    <ul class="listeSimple">
        {% for erreur in liste_erreurs %}
            <li>{{ erreur }}</li>
        {% endfor %}
    </ul>
{% endif %}
{% if methodSend.id is not empty %}
    <div class="col-xs-12" style="margin-top: 10px;">
        <i class="fal fa-info-circle" style="font-size: 100px;
    float: left;
    margin-right: 20px;
    margin-bottom: 20px;
    color: #edcb22;"></i> La facture
        <b>n'a pas été envoyée à la mutuelle</b>. Voulez-vous l'envoyer par email au patient comme habituellement ? <br><br>
        <div class="container-buttons-group-{{ methodSend.data.idfacture }} hidden">
            <a href="javascript:void(0)" class="btn btn-primary btn-sm text-center btn-facture-lot-sendmail-{{ methodSend.data.idfacture }}"><i class='fa fa-paper-plane' aria-hidden='true'></i> Envoyer</a>
        </div>
    </div>
{% endif %}
{% if env=='DEV' %}
    <div class="col-xs-12 hidden">
         <pre>
            <p>Ligne : {{ ligne }}</p>
            <p>Fichier : {{ fichier }}</p>
            <p>Code : {{ code }}</p>
        </pre>
    </div>
{% endif %}
<input type="hidden" name="erreur" value="{{ ligne }}"> <input type="hidden" name="file" value="{{ fichier }}">
<input type="hidden" name="code" value="{{ code }}">

<div class="clear"></div>