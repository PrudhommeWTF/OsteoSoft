{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}
{% from 'macros.twig' import dateToText %}



{% if lignes is empty %}
    <div class='padding15'>Aucun paiement en attente actuellement</div>
{% else %}

    <table class="table table-striped table-hover table-condensed">
        <thead>
        <tr>
            <th>-</th>
            <th>Date</th>
            <th>Libellé</th>
            <th>Montant</th>
            <th>Relance</th>
        </tr>
        </thead>
        <tbody>
        {% set numligne = 0 %}
        {% for ligne in lignes %}
            {% set numligne = numligne + 1 %}
            {% if ligne.type_ligne == 'facture' %}
                {% set facture = ligne %}
                {% set patient = ligne.consultation.patient %}
                {% set href = '/index.php?p=patient&id=' ~ patient.id ~ '&consult=' ~ ligne.consultation.id %}
                {% set sexe = 'fa fa-question iconSexeFa' %}
                {% if patient.sexe == 'm' %}
                    {% set sexe = 'glyphicon glyphicons male colorbleu' %}
                {% endif %}
                {% if patient.sexe == 'f' %}
                    {% set sexe = 'glyphicon glyphicons female colorrose' %}
                {% endif %}
                {% set title = 'Ouvrir la fiche patient' %}
                <tr>
                    <td><a href='{{ href }}' class='noHover' title="{{ title }}">{{ numligne }}</a></td>
                    <td>
                        <a href='{{ href }}' class='noHover' title="{{ title }}">{{ dateToText(facture.consultation.date_consult) }}</a>
                    </td>
                    <td>
                        <a href='{{ href }}' class='noHover' title="{{ title }}"><span class='{{ sexe }}'></span>&nbsp;{{ patient.prenom_nom }} - {{ patient.age }}
                        </a></td>
                    <td>
                        <a href='{{ href }}' class='noHover' title="{{ title }}">{{ facture.montant_ttc }} {{ facture.devise }}</a>
                    </td>
                    <td>
                        <button type='button' class='btn btn-default btn-sm tooltipTop' onclick="lettreRelance('{{ facture.id }}')" title='Écrire une lettre de relance'>
                            <span class='glyphicon glyphicons envelope'></span> </button>
                    </td>
                </tr>

            {% endif %}

            {% if ligne.type_ligne == 'operation' %}
                {% set operation = ligne %}
                {% set href = '/index.php?p=compta' %}
                {% set title = 'Aller à la rubrique comptabilité' %}
                <tr>
                    <td><a href='{{ href }}' class='noHover' title="{{ title }}"><?=$i+1?></a></td>
                    <td><a href='{{ href }}' class='noHover' title="{{ title }}"><?=$date;?></a></td>
                    <td>
                        <a href='{{ href }}' class='noHover' title="{{ title }}"><span class='euro'></span>&nbsp;{{ operation.nom }}
                        </a></td>
                    <td><a href='{{ href }}' class='noHover' title="{{ title }}">{{ operation.nom }} {{ devise }} </a>
                    </td>
                    <td>
                        -
                    </td>
                </tr>
            {% endif %}
        {% endfor %}

        </tbody>
    </table>
{% endif %}
