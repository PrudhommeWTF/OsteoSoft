<div style="width: calc(100% - 110px); float:left; margin-bottom: 20px;">

    La facture
    <a href='javascript:void(0)' style='font-weight:bold' onclick="downloadFacture('{{ facture.id }}')"> {{ facture.numero_formatte }}</a> d'un montant TTC de {{ facture.montant_ttc }} {{ facture.devise }} a bien été créée.
    {% if config.facture_masquer_send_email!='1' and config.offline_mode!='1' %}Vous pouvez choisir de
        <a style='font-weight:bold' href='javascript:void(0)' onclick="sendFacture('{{ facture.id }}')">l'envoyer par email
            <i class='fa fa-envelope'></i></a>.
    {% endif %}




    {% if facture.etat_paiement == 'payee' %}
        {% if medsmart_enable=='1' %}
            {% if facture.teletransmission in ['','0'] and facture.etat in ['finalisee','annulee'] %}
                <br>
                <br>
                Vous pouvez
                <a class="" data-consultation="{{ consultation.id }}" id="btn-teletransmission-{{ consultation.id }}" onclick="launchMedsmartTeletransmissionPatient('{{ consultation.id }}', '{{ facture.id }}');" href="javascript:void(0)"><b>télétransmettre cette facture</b></a> à la mutuelle du patient.
            {% endif %}
            {% if facture.teletransmission in ['1'] and facture.etat in ['finalisee','annulee'] %}
                <br>
                <br>
                <i class="fa fa-check checkVert"></i> La facture a bien été <b>télétransmise</b> à la mutuelle du patient.
            {% endif %}
        {% endif %}
    {% else %}
        <br>
        <br>
        <div class="alert alert-warning">
            <i class="fa fa-warning"></i> Attention, cette facture n'est pas soldée car vous n'avez pas enregistré de paiement.
            <br>
            <br/><a class="noHover" href="javascript:modifPaiement('','{{ facture.id }}','{{ consultation.id }}','');"><i class="fa fa-money"></i> Cliquez ici pour ajouter un paiement</a>.
            <br/><a href="javascript:void(0);" class="noHover btn-partner-payment-{{ consultation.id }}"><i class="fa fa-credit-card"></i> Cliquez ici pour envoyer un lien de paiement</a>.
        </div>
    {% endif %}

</div>