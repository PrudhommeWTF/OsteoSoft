{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}
{% from 'macros.twig' import display_number %}


<h4>Comptabilité du {{ periode_start }} au {{ periode_end }}
    {% if user.login != '' %}
        pour l'utilisateur {{ user.login_texte }}
    {% else %}
        pour tous les utilisateurs
    {% endif %}
</h4><br/>

<table class='table _table-striped table-hover table-condensed tableCleaner' id='tabCA'>
    <thead>
    <tr>
        <th class='num'>
            <div class='checkbox checkbox-inline checkbox-primary sm'>
                <input type='checkbox' id='ckAllListing'/><label for='ckAllListing'></label>
            </div>
            N°
        </th>
        <th class='date'>Date</th>
        <th class='titre'>Titre</th>
        <th style='text-align:right'>Débit</th>
        <th style='text-align:right'>Crédit</th>
        <th class='{sorter: false}' style='text-align:right'>Rétrocession</th>
        <th>Facture</th>
        <th>Paiements</th>
        <th class='edit {sorter: false}'>-</th>
    </tr>
    </thead>
    <tbody>

    {% set ind = 0 %}

    {% for ligne in lignes %}


        {% if ligne.type_ligne == 'facture' %}
            {% if ligne.etat_facturation != 'non_facturable' or config.consultation_gratuite_compta == '1' %}
                {% for facture in ligne.factures %}
                    {% set traite = true %}
                    {% if (facture.etat == 'annulee' or facture.famille == 'avoirs') %}
                        {% set traite = false %}
                    {% endif %}
                    {% if traite %}
                        {% set ind = ind + 1 %}
                        {% set consultation = ligne %}
                        {% set patient = consultation.patient %}
                        {% include 'comptabilite/include_ligne_facture.twig' %}
                    {% endif %}
                {% endfor %}
            {% endif %}
        {% endif %}

        {% if ligne.type_ligne == 'operation' %}
            {% set ind = ind + 1 %}
            {% set operation = ligne %}
            {% include 'comptabilite/include_ligne_operation.twig' %}
        {% endif %}


    {% endfor %}


    </tbody>

    <tfoot>

    <tr class='totaux'>
        <td class='noBorder num'><br/></td>
        <td class='noBorder date'><br/></td>
        <td class='titre'>Total des opérations HT</td>
        <td id='totDebitHT' class='montant'>{{ display_number(total_depenses_ht,config.devise) }}</td>
        <td id='totCreditHT' class='montant'>
            {{ display_number(total_ca_ht,config.devise) }}
            <input type='hidden' id='valTotCredit' value='{{ total_ca_ht }}'/>
            <input type='hidden' id='valTotDebit' value='{{ total_depenses_ht }}'/>
        </td>
    </tr>

    <tr class='totaux'>
        <td class='noBorder num'><br/></td>
        <td class='noBorder date'><br/></td>
        <td class='titre'>Montant TVA</td>
        <td id='totDebitHT' class='montant'>{{ display_number(total_depenses_ttc - total_depenses_ht,config.devise) }}
        <td id='totCreditHT' class='montant'>{{ display_number(total_ca_ttc - total_ca_ht,config.devise) }}
    </tr>

    <tr class='totaux'>
        <td class='noBorder num'><br/></td>
        <td class='noBorder date'><br/></td>
        <td class='titre'>Total des opérations TTC</td>
        <td id='totDebitTTC' class='montant'>{{ display_number(total_depenses_ttc,config.devise) }}
        <td id='totCreditTTC' class='montant'>{{ display_number(total_ca_ttc,config.devise) }}

    </tr>


    <tr class='totaux'>
        <td class='noBorder num'><br/></td>
        <td class='noBorder date'><br/></td>
        <td class='titre'>Total des paiements</td>
        <td id='totDebitTTC' class='montant'>{{ display_number(total_paiements_debit,config.devise) }}
        <td id='totCreditTTC' class='montant'>{{ display_number(total_paiements_credit,config.devise) }}

        <td class='titre noBorder' colspan='3'>
            <button type='button' class='btn btn-default btn-sm tooltipTop' title='Afficher / Masquer le détail des paiements' onclick='showDetailCompta(this)'>
                <span id='linkDetail' class='glyphicon glyphicons {% if detail_compta == '1' %}eye_close{% else %}eye_open{% endif %}'></span>
            </button>
        </td>
    </tr>


    {% for paiement in liste_paiements %}
        {% if paiement.id != 'avoir' %}
            {% if paiement.total_ca != 0 or paiement.total_depenses != 0 %}
                <tr class='totauxdetail {% if detail_compta != '1' %}hiddenMC{% endif %}'>
                    <td class='noBorder num'></td>
                    <td class='noBorder date'></td>
                    <td class='titre'>Paiements enregistrés en {{ paiement.libelle }}</td>
                    <td class='montant'>{{ display_number(paiement.total_depenses,config.devise) }}<br/></td>
                    <td class='montant'>{{ display_number(paiement.total_ca,config.devise) }}<br/></td>
                </tr>
            {% endif %}
        {% endif %}

    {% endfor %}


    <tr class='totaux {% if user.login is empty %}hidden{% endif %}'>
        <td class='noBorder num'></td>
        <td class='noBorder date'></td>
        <td class='titre'>Total des rétrocessions
            <i class="fa fa-info-circle tooltipTop" title="Calculé sur le montant HT des consultations"></i></td>
        <td id='totRetroDebit' class='montant'><br/></td>
        <td id='totRetroCredit' class='montant'><br/></td>
    </tr>

    <tr class='totaux {% if user.login is empty %}hidden{% endif %}'>
        <td class='noBorder num'></td>
        <td class='noBorder date'></td>
        <td class='titre'>Bénéfices</td>
        <td id='totBenefDebit' class='montant'><br/></td>
        <td id='totBenefCredit' class='montant'><br/></td>
    </tr>

    </tfoot>
</table>


<input type='hidden' id='valCreditRetro' value='{{ valCreditRetro }}'/>


