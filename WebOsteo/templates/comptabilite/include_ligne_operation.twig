{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}

{% set class = 'success row_' ~ operation.createdby %}
{% if operation.type_operation == 'depense' %}
    {% set class = 'danger row_' ~ operation.createdby %}
{% endif %}
{% if operation.paiement_moyen == 'attente' %}
    {% set class = class ~' attente' %}
{% endif %}



<tr typerow='{{ operation.type_operation }}' class='{{ class }}'>
    <td class='num nowrap'>
        <div class='checkbox checkbox-inline checkbox-primary sm '>
            <input id='ck_{{ operation.id }}' value="{{ operation.id }}" type='checkbox' name='ckIdO[]'/><label for='ck_{{ operation.id }}'></label>
        </div>
        {{ ind }}
    </td>

    <td class='date nowrap'>
        {{ operation.date_operation_format }}
    </td>


    <td class="titre">
        {% if user.login is empty %}
            {{ operation.createdby_text }} :
        {% endif %}
        {{ operation.nom }}
    </td>

    <td class='montant nowrap'>
        {% if operation.type_operation=='recette' %}
            <br/>
        {% else %}
            {{ operation.paiement_montant }} {{ config.devise }}
        {% endif %}
    </td>
    <td class='montant nowrap'>
        {% if operation.type_operation=='depense' %}
            <br/>
        {% else %}
            {{ operation.paiement_montant }} {{ config.devise }}
        {% endif %}
    </td>

    <td class="montant">-</td>
    <td class="numfacture">-</td>

    <td class='comment'>

        {% if operation.paiement_bordereau_cheque is not empty or operation.paiement_bordereau_especes is not empty %}
            {% set comment = '' %}
            {% if operation.paiement_cheque_num != '' %}
                {% set comment = 'Référence : ' ~ operation.paiement_cheque_num %}
            {% endif %}
            {% if operation.paiement_bordereau_cheque is not empty %}
                <span class='label label-success pointer cursor tooltipTop' title="Remis en banque. {{ replaceGuillemets(comment) }}" onclick="genereRemiseCheque('{{ operation.paiement_bordereau_cheque }}');" style="cursor:pointer">
                        <i class='glyphicon glyphicons bank'></i>
                        {{ liste_paiements[operation.paiement_moyen].libelle }} {{ operation.paiement_montant }} {{ config.devise }}
                    </span>
            {% endif %}
            {% if operation.paiement_bordereau_especes is not empty %}
                <span class='label label-success pointer cursor tooltipTop' title="Remis en banque. {{ replaceGuillemets(comment) }}" onclick="genereRemiseEspeces('{{ operation.paiement_bordereau_especes }}');" style="cursor:pointer">
                        <i class='glyphicon glyphicons bank'></i>
                        {{ liste_paiements[operation.paiement_moyen].libelle }} {{ operation.paiement_montant }} {{ config.devise }}
                    </span>
            {% endif %}
        {% else %}
            <span class='label label-success'>{{ liste_paiements[operation.paiement_moyen].libelle }} {{ operation.paiement_montant }} {{ config.devise }}</span>
        {% endif %}



    </td>



    <td class='edit nowrap'>
        <button type='button' class='btn btn-default btn-sm tooltipTop' onclick="modifOperation('{{ operation.id }}')" title='Détail de cette opération'>
            <i class='glyphicon glyphicon-edit'></i></button>
        </button>

        {% if operation.attachments|length >0 %}
            <button type='button' class='btn btn-default btn-sm tooltipTop' onclick='downloadOperation("{{ operation.id }}")' title='Télécharger la pièce jointe'><i class='glyphicon glyphicons disk_save'></i></button>
        {% endif %}

        <!--
        {% if operation.paiement_bordereau_cheque is not empty %}
            <button type='button' class='btn btn-default btn-sm tooltipTop' onclick='genereRemiseCheque("{{ operation.paiement_bordereau_cheque }}")' title='Ce chèque est inclus dans un bordereau de remise de chèque - cliquer pour imprimer'><i class='glyphicon glyphicons bank'></i></button>
        {% endif %}

        {% if operation.paiement_bordereau_especes is not empty %}
            <button type='button' class='btn btn-default btn-sm tooltipTop' onclick='genereRemiseEspeces("{{ operation.paiement_bordereau_especes }}")' title="Ce paiement est inclus dans un bordereau de remise d'espèces - cliquer pour imprimer"><i class='glyphicon glyphicons bank'></i></button>
        {% endif %}
        -->

    </td>


</tr>