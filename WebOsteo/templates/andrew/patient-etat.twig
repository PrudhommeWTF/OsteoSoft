<div class="form-group">
    <label class="col-sm-4 control-label"><i class="fa fa-fw fa-user-circle"></i> Andrew® :</label>
    <div class="col-sm-8" id='container-liens-primocreno'>
        {% if andrew.linked is same as (true) %}
            <a href="{{ andrew.url }}" class="tooltipTop noHover" title="Voir la fiche Andrew" target="_blank"><i class="fa fa-check checkVert"></i> Ce patient est lié à
                <b>Andrew®</b></a>
        {% else %}
            {% if andrew.code in ['invite_sent','created'] %}
                <a href="{{ andrew.url }}" class="tooltipTop noHover" title="Voir la fiche Andrew" target="_blank"><i class="fa fa-check checkVert"></i> Ce patient est lié à
                    <b>Andrew®</b>.<br/> Un email lui a été envoyé.
                    {% if andrew.temp_password %}
                        <br/><span>Le code temporaire est <b>{{ andrew.temp_password }}</b>.</span>
                    {% endif %}
                </a>
            {% else %}
                <a href="javascript:void(0)" class="andrewCreationPatient noHover"><i class="fa fa-fw fa-at"></i> Créer ce patient sur <b>Andrew®</b></a>
            {% endif %}
        {% endif %}
    </div>
</div>