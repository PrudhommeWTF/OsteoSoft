{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}
{% autoescape false %}



<div class="form-group">
    <label class="col-sm-4 control-label">Moyen de paiement :</label>
    <div class="col-sm-7">
        <select class="selectpicker" data-width="100%" data-container="body" name='paiement_moyen' id='selectPaiementMoyen' onchange="displayDetailPaiement('{{ consultation.id }}',this)">
            {% if editForm is empty %}
                <option value='attente' selected='selected' data-content="<span class='orange'><i class='fa fa-clock-o fa-fw '></i> Paiement en attente</span>"> Paiement en attente</option>
            {% endif %}
            {% for paiement_moyen in moyens_paiement %}
                {% if (paiement_moyen.id != 'attente' and paiement_moyen.id != 'gratuit' and paiement_moyen.id != 'avoir') %}
                    {% set txt = "<span class='checkVert'><i class='fa fa-check fa-fw checkVert'></i> " ~ paiement_moyen.libelle ~ "</span>" %}
                    {% set selected = false %}
                    {% if paiement_moyen.id == paiement.moyen_paiement %}
                        {% set selected = true %}
                    {% endif %}
                    <option value="{{ paiement_moyen.id }}" data-content="{{ replaceGuillemets(txt) }}" {% if selected %}selected{% endif %}>{{ paiement_moyen.libelle }}</option>
                {% endif %}
            {% endfor %}
        </select>
    </div>
</div>



<div id='contain_paiement_commentaire' class="hidden">

    <div class="form-group">
        <label class="col-sm-4 control-label">Montant du paiement :</label>
        <div class="col-sm-7">
            {% if editForm %}
                <input type="text" class="form-control input-sm " value="{{ paiement_facture.montant }}" name='paiementMontant'  alt='int' style="width:70px;" />
            {% else %}
                <input type="text" class="form-control input-sm " value="0" name='paiementMontant' id='paiementMontant'  alt='int' style="width:70px;" />
            {% endif %}
            {% if editForm %}
                {{ facture.devise }}
            {% else %}
                {{ config.devise }}
            {% endif %}
        </div>
    </div>

    <div class="form-group">
        <label class="col-sm-4 control-label">Date du paiement :</label>
        <div class="col-sm-7">
            {% set datePaiement = date_jour %}
            {% if paiement.date_paiement is not empty %}
                {% set datePaiement = paiement.date_paiement_format %}
            {% endif %}
            <input type="text" class="form-control input-sm inputDate" value="{{ datePaiement }}" name='paiementDate' calendar='true'/>
        </div>
    </div>

    <div class="form-group">
        <label class="col-sm-4 control-label">Référence du paiement :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" value="{{ (paiement.reference) }}" name='paiementReference'/>
        </div>
    </div>

    <div class="form-group">
        <label class="col-sm-4 control-label">Commentaire du paiement :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" value="{{ (paiement.commentaire) }}" name='paiementComment'/>
        </div>
    </div>

    <div class='paiement_commentaire cheque hidden'>

        <div class="form-group">
            <label class="col-sm-4 control-label">Emetteur :</label>
            <div class="col-sm-7">
                <input type="text" class="form-control input-sm" value="{{ (paiement.cheque_emetteur) }}" name='paiementChequeEmetteurConsult'/>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Lieu du chèque :</label>
            {% set ville = cabinet.ville %}
            {% if editForm %}
                {% set ville = paiement.paiement_lieu %}
            {% endif %}
            <div class="col-sm-7">
                <input type="text" class="form-control input-sm" value="{{ (ville) }}" name='paiementChequeLieu'/>
            </div>
        </div>
        <div class="form-group">
            <label class="col-sm-4 control-label">Banque :</label>
            <div class="col-sm-7">
                <input type="text" class="form-control input-sm typeahead" value="{{ (paiement.paiement_banque) }}" name='paiementChequeBanque' id='paiementBanqueChequeConsult'/>
            </div>
        </div>


    </div>

</div>

{% endautoescape  %}