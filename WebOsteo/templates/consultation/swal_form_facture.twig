{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}


<table class='table table-striped table-hover table-condensed tablePrestations'>
    <thead>
    <th>Prestation</th>
    <th style='width:30px; text-align:right'>Quantité</th>
    <th style='width:95px; text-align:right'>Montant HT</th>
    <th style='width:80px; text-align:right'>TVA</th>
    <th style='width:100px; text-align:right'>Montant TTC</th>
    <th style='width:100px; text-align:right'>-</th>
    </thead>
    <tbody id='tbodyPrestations'>


    {% for prestation in consultation.prestations_consult %}
        {% include 'consultation/include_ligne_prestation.twig' %}
    {% endfor %}


    </tbody>

</table>


<input type='hidden' id='jsonPaiementConsult' name='jsonPaiementConsult'/>
<input type='hidden' name='idconsult' value="{{ consultation.id }}"/>
<input type='hidden' name='type_action' value="save_facture"/>


<h4 class="alignCenter" style="margin-top: 30px; margin-bottom: 30px; font-weight: bold;">FACTURER
    <span id="montant_ttc"></span> {{ config.devise }}</h4><!--
<div class="form-group">
    <label class="col-sm-4 control-label"><b>Total facturé :</b></label>
    <div class="col-sm-7">
        <b><span id="montant_ttc"></span> {{ config.devise }}</b>
    </div>
</div>
-->


{% if config.pays != 'suisse' %}
    <div class="form-group">
        <label class="col-sm-4 control-label">Sexe :</label>
        <div class="col-sm-7">
            <div class="radio radio-inline radio-primary sm ">
                <input type='radio' id='ck_sexe_fac_' name='facture_sexe' value='' {% if (patient.sexe == '') %}checked{% endif %}><label for='ck_sexe_fac_' class='_colorrose'><span class="fa fa-question iconSexeFa"></span> Indéterminé</label>
            </div>
            <div class="radio radio-inline radio-primary sm ">
                <input type='radio' id='ck_sexe_fac_f' name='facture_sexe' value='f' {% if (patient.sexe == 'f') %}checked{% endif %} /><label for='ck_sexe_fac_f' class='colorrose'><span class="glyphicon glyphicons female"></span> Femme</label>
            </div>
            <div class="radio radio-primary radio-inline  sm">
                <input type='radio' id='ck_sexe_fac_m' name='facture_sexe' value='m' {% if (patient.sexe == 'm') %}checked{% endif %} /><label class='colorbleu' for='ck_sexe_fac_m'><span class="glyphicon glyphicons male"></span> Homme</label>
            </div>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-4 control-label">Nom :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm obligatoire" id='paiement_nom' name='paiement_nom' value="{{ patient.nom }}"/>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-4 control-label">Prénom :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm obligatoire" id='paiement_prenom' name='paiement_prenom' value="{{ patient.prenom }}"/>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-4 control-label">Téléphone portable :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" id='paiement_telephone1' name='paiement_telephone1' value="{{ patient.telephone1 }}"/>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-4 control-label">Email :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" id='paiement_email' name='paiement_email' value="{{ patient.email }}"/>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-4 control-label">Date de naissance :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm inputDate facturation_ddn" id='paiement_date_naissance' name='paiement_date_naissance' calendar='true' value="{{ patient.date_naissance_format }}"/>
        </div>
    </div>
    <div class="form-group">
        <label class="col-sm-4 control-label">Adresse :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" id='paiement_adresse1' name='paiement_adresse1' value="{{ patient.adresse1 }}"/>
        </div>
    </div>

    <div class="form-group">
        <label class="col-sm-4 control-label">Adresse (suite) :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" id='paiement_adresse2' name='paiement_adresse2' value="{{ patient.adresse2 }}"/>
        </div>
    </div>

    <div class="form-group">
        <label class="col-sm-4 control-label">Code postal :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" id='paiement_cp' name='paiement_cp' value="{{ patient.code_postal }}" style="width:70px;"/>
        </div>
    </div>

    <div class="form-group">
        <label class="col-sm-4 control-label">Ville :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" id='paiement_ville' name='paiement_ville' value="{{ patient.ville }}"/>
        </div>
    </div>

    <div class="form-group">
        <label class="col-sm-4 control-label">Pays :</label>
        <div class="col-sm-7">
            <select class='selectpicker' id="paiement_pays" name='paiement_pays' data-live-search='true'>
                <option value='' {% if patient.pays=='' %}selected{% endif %}>
                    Aucun
                </option>
                {% for pays in liste_pays %}
                    <option value="{{ pays.id }}" {% if patient.pays==pays.id %}selected{% endif %}>{{ pays.label }}</option>
                {% endfor %}
            </select>
        </div>
    </div>




    {% if (config.pays != 'canada') %}
        <div class="form-group">
            <label class="col-sm-4 control-label">N° de Sécurité Sociale :</label>
            <div class="col-sm-7">
                <input type="text" class="form-control input-sm facturation_secu" id='paiement_secu' name='paiement_secu' value="{{ patient.secu }}"/>
            </div>
        </div>
        <div class="form-group hiddenWebosteo">
            <label class="col-sm-4 control-label">Mutuelle :</label>
            <div class="col-sm-7">
                <input type="text" class="form-control input-sm facturation_mutuelle" id='paiement_mutuelle' name='paiement_mutuelle' value="{{ patient.assurance }}"/>
            </div>
        </div>
    {% endif %}

    <div class="form-group">
        <label class="col-sm-4 control-label">Nom du document :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm" id='paiement_libelle' name='paiement_libelle' value="{{ config.libelle_facture }}"/>
        </div>
    </div>

{% endif %}


{% if config.pays == 'suisse' %}
    <div class="form-group">
        <label class="col-sm-4 control-label">Thérapie :</label>
        <div class="col-sm-7">
            <select class="selectpicker" data-width="100%" data-container="body" name='paiement_therapie'>
                <option value=''></option>
                <option value='individuelle'>Thérapie individuelle</option>
                <option value='groupe'>Thérapie de groupe</option>
            </select>
        </div>
    </div>


    <div class="form-group">
        <label class="col-sm-4 control-label">Loi :</label>
        <div class="col-sm-7">
            <select class="selectpicker" data-width="100%" data-container="body" name='paiement_loi'>
                <option value='' selected></option>
                {% for loi in lois %}
                    <option value='{{ loi }}'>{{ loi }}</option>
                {% endfor %}
            </select>
        </div>
    </div>


    <div class="form-group">
        <label class="col-sm-4 control-label">Motif de traitement :</label>
        <div class="col-sm-7">
            <select class="selectpicker" data-width="100%" data-container="body" name='paiement_motif_traitement' id='paiement_motif_traitement'>
                {% for motif_traitement in motifs_traitement %}
                    <option value="{{ motif_traitement[0] }}" {% if motif_traitement[0] == consultation.traitement_type %}selected{% endif %}>{{ motif_traitement[1] }}</option>
                {% endfor %}
            </select>
        </div>
    </div>


    <div class="form-group">
        <label class="col-sm-4 control-label">Date du cas :</label>
        <div class="col-sm-7">
            <input type="text" class="form-control input-sm syncDateCas" calendar='true' style='width:80px' value="{{ consultation.date_consult_format }}" name='paiement_dateCasConsult'/>
        </div>
    </div>

{% endif %}


<div class="form-group">
    <label class="col-sm-4 control-label">Mentions supplémentaires :</label>
    <div class="col-sm-7">
        <select class="selectpicker" data-width="100%" data-container="body" name='paiement_mentions[]' multiple data-selected-text-format="count" addResults='1' data-live-search='true'>
            {% if (config.pays == 'suisse') %}
                {% set txt_suivi = "Traitement débuté le " ~ consultation.date_consult_format ~ ", en cours / terminé le..." %}
                {% if suivi is not empty %}
                    {% set txt_suivi = "Traitement débuté le " ~ suivi.date_consult_format ~ ", en cours / terminé le..." %}
                {% endif %}
                <option value="{{ replaceGuillemets(txt_suivi) }}">{{ txt_suivi }}</option>
            {% endif %}

            {% for mention in mentions_base %}
                <option value="{{ replaceGuillemets(mention.value) }}" {% if (mention.selected) %}selected{% endif %}>{{ mention.value }}</option>
            {% endfor %}
        </select>
    </div>
</div>

{% if praticien.signature_url is not empty %}
    <div class="form-group">
        <label class="col-sm-4 control-label" for="ck_signature">Intégrer la signature :</label>
        <div class="col-sm-7">
            <div class="checkbox checkbox-inline checkbox-primary sm ">
                <input type='checkbox' id='ck_signature' name='facture_signature' value='1' {% if praticien.signature_defaut is not empty %}checked{% endif %}>
                <label for='ck_signature' class='_colorrose'></label>
            </div>
        </div>
    </div>
{% endif %}

<div class="form-group">
    <label class="col-sm-4 control-label">Commentaire interne :</label>
    <div class="col-sm-7">
        <input type="text" class="form-control input-sm" value="" name='commentInterneFacture'/>
    </div>
</div>


{% include 'consultation/include_form_paiement.twig' %}


<div class="col-sm-10 col-sm-offset-1" style="margin-top:20px">
    <div class="alert alert-warning">
        <i class="fa fa-info-circle"></i> Attention, une fois enregistrée, cette facture entrera en comptabilité et ne pourra pas être effacée ou modifiée. Vous pourrez tout de même annuler la facture, cela génèrera automatiquement une facture d'avoir (= facture au montant négatif) qui entrera également en comptabilité.
    </div>
</div>

<div class="clear"></div>
<script type="text/javascript">

</script>