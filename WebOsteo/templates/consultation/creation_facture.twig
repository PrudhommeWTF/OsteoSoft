{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}

{% set class='warning' %}
{% if consultation.etat_facturation == 'non_facturable' %}
    {% set class='success' %}
{% endif %}

<div class="alert alert-{{ class }}" style="margin-top: 25px;">
    {% if droits.annuler_facture %}
        {% if consultation.etat_facturation == 'non_facturable' %}
            Cette consultation est notée comme gratuite. Le commentaire associé est : <b>{{ consultation.paiement_comment }}</b>
        {% else %}
            <b>Cette consultation ne semble pas facturée actuellement. Si vous facturez cette consultation, la fiche patient sera automatiquement enregistrée.</b>
        {% endif %}
        <br/><br/><br/>

        <div class="alignCenter">

            <button type="button" class="btn btn-primary btn-sm btFacture" id='btFormFactureConsult_{{ consultation.id }}'>
                <i class="fa fa-dollar"></i> Facturer cette consultation
            </button>

            {% if consultation.etat_facturation != 'non_facturable' %}
                <button style="margin-left:5px" type="button" class="btn btn-default btn-sm" id='btFreeConsult_{{ consultation.id }}'>
                    <i class="fa fa-ban"></i> Définir comme acte gratuit
                </button>
            {% else %}
                <button style="margin-left:5px" type="button" class="btn btn-default btn-sm" id='btUnfreeConsult_{{ consultation.id }}'>
                    <i class="fa fa-ban"></i> Annuler la gratuité de l'acte
                </button>
            {% endif %}
        </div>
    {% else %}
        <b>Vous ne semblez pas avoir les droits pour facturer une consultation.</b>
    {% endif %}

</div>


    <script type="text/javascript">
        $('#btFormFactureConsult_{{ consultation.id }}').on('click',function() {
            formFacture('{{ consultation.id }}');
        });
        $('#btFreeConsult_{{ consultation.id }}').on('click',function() {
            setFreeConsult('{{ consultation.id }}');
        });
        $('#btUnfreeConsult_{{ consultation.id }}').on('click',function() {
            unsetFreeConsult('{{ consultation.id }}');
        });
        $('#badgeMontantGlobal_{{ consultation.id }}').tooltip('destroy').data('original-title',null).attr('data-original-title',null).html('0 {{ devise }}').attr('class','badge pull-right tooltipTop').attr('title','');
    </script>




