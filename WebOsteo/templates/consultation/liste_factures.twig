{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}
{% autoescape false %}

    <div class="container_liste_facture">
        {% for facture in factures %}

            <div class="item_facture {{ facture.etat }}">
                <h4 onclick="$('#detail_facture_{{ facture.id }}').slideToggle();">
                    {% if facture.teletransmission == '1' %}
                        <i class="glyphicon glyphicon-share-alt"></i>
                    {% else %}
                        <i class="fa fa-file-text"></i>
                    {% endif %}
                    Facture {{ facture.etat_texte }} n°
                    <b>{{ facture.numero_formatte }}</b> ({{ facture.montant_ttc }} {{ facture.devise }}) :
                    <i class="iconToggle fa fa-chevron-down"></i>
                </h4>
                <div class="detail" {% if facture.etat=='annulee' %}style="display: none;" {% endif %}id="detail_facture_{{ facture.id }}">
                    Cette consultation a été est facturée le
                    <b>{{ facture.numero_date_format_full }}</b> pour un montant total de
                    <b>{{ facture.montant_ttc }} {{ facture.devise }}</b> <br/>Commentaire interne :
                    <span id="comment_{{ consultation.id }}_{{ facture.id }}" class="bold">{{ facture.commentaire_interne }}</span>
                    <a href="javascript:modifComment('{{ facture.id }}','{{ consultation.id }}');"><i class="fa fa-pencil tooltipTop" title="Ajouter ou modifier le commentaire interne"></i></a>
                    <br/><span style="color:#888; font-style: italic">Facture associée au praticien <i class="fa fa-user"></i> {{ facture.personne_praticien.prenom_nom }}
                        <!--<i class="fa fa-info-circle" style="cursor:pointer" onclick="$('#comments_hidden_fac_{{ facture.id }}').slideToggle()"></i> -->
                    </span>
                    <!--
                    <div id="comments_hidden_fac_{{ facture.id }}" style="display:none; color:#888; font-style: italic">Facture créée par
                        <i class="fa fa-user"></i> {{ facture.created_by_format }} le {{ facture.numero_date_format_full }}
                    </div>
                    --><br/><br/>


                    <div class="btn-group">
                        <button type="button" class="btn btn-primary btn-sm" onclick="downloadFacture('{{ facture.id }}',false)">
                            <i class="fa fa-download"></i> Télécharger la facture
                        </button>
                        {% if facture.etat != 'annulee' %}
                            <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                <span class="caret"></span> <span class="sr-only"></span>
                            </button>
                            <ul class="dropdown-menu miniSousMenu" role="menu">
                                <li>
                                    <a href="javascript:void(0)" onclick="downloadFacture('{{ facture.id }}',true)"><i class="fa fa-download"></i> Télécharger le duplicata</a>
                                </li>
                            </ul>
                        {% endif %}
                    </div>

                    {% if config.facture_masquer_send_email != '1' and config.offline_mode != '1' %}
                        <button type="button" class="btn btn-primary btn-sm" data-toggle="dropdown" aria-expanded="false" onclick="sendFacture('{{ facture.id }}')">
                            <i class="fa fa-envelope"></i> Envoyer par email
                        </button>
                    {% endif %}

                    {% if facture.etat != 'annulee' %}
                        {% if droits.annuler_facture %}
                            <button type="button" class="btn btn-danger btn-sm" onclick="annulerFacture('{{ facture.id }}','{{ consultation.id }}')">
                                <i class="fa fa-ban"></i> Annuler cette facture
                            </button>
                        {% endif %}
                    {% else %}
                        {% if facture.facture_avoir.id is not empty %}

                            <button type="button" class="btn btn-primary btn-sm" onclick="downloadFacture('{{ facture.facture_avoir.id }}')">
                                <i class="fa fa-download"></i> Télécharger la facture d'avoir (n°{{ facture.facture_avoir.numero_formatte }})
                            </button>
                            {% if facture.teletransmission == '1' and facture.etat in ['annulee'] %}
                                <div style="display:inline" id="container-teletransmission-{{ consultation.id }}">
                                    <span class="tooltipTop" title="Cette facture a été télétransmise le {{ facture.date_teletransmission_format }}">
 <a class="btn btn-success btn-sm  disabled" data-consultation="{{ consultation.id }}" id="btn-teletransmission-info-{{ consultation.id }}" href="javascript:void(0)"><i class="glyphicon glyphicon-info-sign"></i></a>

                                    </span>
                                </div>
                            {% endif %}

                            <!--
                            <div class="btn-group">
                                <button type="button" class="btn btn-primary btn-sm" onclick="downloadFacture('{{ facture.facture_avoir.id }}')">
                                    <i class="fa fa-download"></i> Télécharger la facture d'avoir (n° {{ facture.facture_avoir.numero_formatte }})
                                </button>
                                <button type="button" class="btn btn-primary btn-sm dropdown-toggle" data-toggle="dropdown" aria-expanded="false">
                                    <span class="caret"></span> <span class="sr-only">Sous-Menu</span>
                                </button>
                                <ul class="dropdown-menu miniSousMenu" role="menu" style="width:100%;">
                                    <li style="width:100%;">
                                        <a href="javascript:void(0)" onclick="downloadFacture('{{ facture.facture_avoir.id }}',true)"><i class="fa fa-download"></i> Télécharger le duplicata de l'avoir</a>
                                    </li>
                                </ul>
                            </div>
                            -->

                        {% endif %}
                    {% endif %}

                    <br/><br/>
                    {% if facture.etat == 'finalisee' %}
                        <h5 style="font-weight: bold">Informations paiements ({{ facture.montant_paiement }} {{ facture.devise }})</h5>
                        Cette facture est {{ facture.etat_paiement_html|raw }}.

                        {% if facture.paiements_facture|length == 0 %}
                            Il n'y a aucun paiement enregistré.
                        {% else %}
                            Voici la liste des paiements :<br/>
                        {% endif %}

                        {% for paiement_facture in facture.paiements_facture %}
                            <span {% if paiement_facture.paiement.paiement_moyen.id == 'avoir' %} style="color:#888;"{% endif %}>
                            <br/><i class="fa fa-money"></i> Paiement de <b>{{ paiement_facture.montant }} {{ facture.devise }}</b> par {{ paiement_facture.paiement.paiement_moyen.libelle }} le {{ paiement_facture.paiement.date_paiement_format_full }}
                            </span>

                            {% if paiement_facture.paiement.paiement_moyen.id != 'avoir' %}
                                -
                                <a href="javascript:modifPaiement('{{ paiement_facture.id }}','{{ facture.id }}','{{ consultation.id }}','{{ paiement_facture.paiement.id }}');"><i class="fa fa-pencil tooltipTop" title="Modifier ce paiement"></i></a>
                                |
                                <a href="javascript:deletePaiement('{{ paiement_facture.id }}','{{ facture.id }}','{{ consultation.id }}','{{ paiement_facture.paiement.id }}');"><i class="fa fa-trash tooltipTop" title="Supprimer ce paiement"></i></a>
                            {% endif %}
                        {% endfor %}

                        {% if facture.liens_paiement|length>0 %}
                            <div class="col-md-12 nopadding">
                                <hr>
                            </div>
                            <div class="row">
                                <div class="col-md-12 nopadding header-consultation-title">
                                    <h5>Liste des liens de paiement
                                        <span class="label label-info" style="float: right;cursor:pointer"><i class="fa fa-refresh refreshListTransaction-{{ consultation.id }} tooltipTop" title="Rafraîchir les liens de paiement" data-facture="{{ facture.id }}"></i></span>
                                    </h5>
                                </div>
                                <div class="col-md-12 nopadding table-responsive" id="table-transactions-{{ facture.id }}">
                                    {% include 'paiement-ligne/table-liens-facture.twig' %}
                                </div>
                            </div>

                        {% endif %}


                        <br/><br/>
                        {% if facture.famille == 'factures' and facture.etat == 'finalisee' %}
                            <button type="button" class="btn btn-primary btn-sm" onclick="modifPaiement('','{{ facture.id }}','{{ consultation.id }}','')">
                                <i class="fa fa-money"></i> Ajouter un paiement
                            </button>
                        {% endif %}

                        {% if facture.teletransmission in ['','0'] and facture.etat in ['finalisee','annulee'] and facture.personne_praticien.medsmart_connected=='1' %}
                            <div style="display:inline" id="container-teletransmission-{{ consultation.id }}">
                                <a class="btn btn-primary btn-sm tooltipTop" data-consultation="{{ consultation.id }}" id="btn-teletransmission-{{ consultation.id }}" title="Télétransmettre cette facture à la mutuelle du patient" onclick="launchMedsmartTeletransmissionPatient('{{ consultation.id }}', '{{ facture.id }}');" href="javascript:void(0)"><img src="/images/partenariats/boutons/Medsmart-Blanc.png" style="width: 16px;"></a>
                            </div>
                        {% endif %}
                        {% if facture.teletransmission == '1' and facture.etat in ['finalisee','annulee'] %}
                            <div style="display:inline" id="container-teletransmission-{{ consultation.id }}">
                                    <span class="tooltipTop" title="Cette facture a été télétransmise le {{ facture.date_teletransmission_format }}">
 <a class="btn btn-success btn-sm  disabled" data-consultation="{{ consultation.id }}" id="btn-teletransmission-info-{{ consultation.id }}" href="javascript:void(0)"><i class="glyphicon glyphicon-info-sign"></i></a>
                                    </span>
                            </div>
                        {% endif %}
                        {% if facture.etat in ['finalisee'] %}
                            <a href="javascript:void(0)" class="btn btn-primary btn-sm tooltipTop btn-partner-payment-{{ consultation.id }}" data-consultation="{{ consultation.id }}" title="Envoyer un lien de paiement">
                                <i class="fa fa-credit-card" style="font-size: 14px"></i> </a>
                        {% endif %}

                    {% endif %}

                </div>
            </div>


        {% endfor %}
    </div>
    <script type="text/javascript">
        {% set class = '' %}
        {% set montant_paiement = '0' %}
        {% set title = '' %}
        {% for facture in factures %}
        {% set class = '' %}
            {% if facture.etat == 'finalisee' and facture.famille=='factures' %}
                {% set class = 'paiementValid' %}
                {% set montant_paiement = facture.montant_ttc %}
                {% set title = '' %}
                {% if facture.balance is not empty %}
                    {% set class = 'paiementAttente' %}
                    {% set montant_paiement = facture.montant_paiement ~ ' / ' ~ facture.montant_ttc %}
                    {% set title = 'Montant payé / Montant facturé' %}
                    {% if facture.balance == facture.montant_ttc %}
                        {% set montant_paiement = facture.montant_ttc %}
                        {% set title = 'Montant en attente de paiement' %}
                    {% endif %}
                {% endif %}
            {% endif %}
        {% endfor %}
        $('#badgeMontantGlobal_{{ consultation.id }}').tooltip('destroy').data('original-title', null).attr('data-original-title', null).html('{{ montant_paiement }} {{ devise }}').attr('class', 'badge pull-right tooltipTop {{ class }}').attr('title', "{{ title }}").tooltip({placement: 'top'});
    </script>
{% endautoescape %}
