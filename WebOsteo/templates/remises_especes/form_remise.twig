{% import 'macros.twig' as macros_base %}
{% from 'macros.twig' import replaceGuillemets %}
{% from 'macros.twig' import display_number %}
{% from 'macros.twig' import dateToText %}


<input type='hidden' value='{{ remise.id }}' name='idRemise'/>
<input type='hidden' value="{{ replaceGuillemets(remise.createdby) }}" name='createdby'/>
<div class='form-group'><label class='col-sm-4 control-label'>Date :</label>
    <div class='col-sm-7'>
        <input type='text' class='form-control input-sm inputDate obligatoire' name='date_remise' value='{{ dateToText(remise.date) }}' calendar='true'/>
    </div>
</div>
<div class='form-group'><label class='col-sm-4 control-label'>Code du bordereau :</label>
    <div class='col-sm-7'>
        <input type='text' class='form-control input-sm' value="{{ replaceGuillemets(remise.code) }}" name='code_remise'/>
    </div>
</div>
<div class='form-group'><label class='col-sm-4 control-label'>Nom de la banque :</label>
    <div class='col-sm-7'>
        <input type='text' class='form-control input-sm' value="{{ replaceGuillemets(remise.banque) }}" name='banque_remise'/>
    </div>
</div>
<div class='form-group'><label class='col-sm-4 control-label'>Compte bancaire :</label>
    <div class='col-sm-7'>
        <input type='text' class='form-control input-sm' value="{{ replaceGuillemets(remise.compte) }}" name='compte_remise'/>
    </div>
</div>
<div class='form-group'><label class='col-sm-4 control-label'>Commentaires :</label>
    <div class='col-sm-7'>
        <textarea class='form-control input-sm resizer' name='comment_remise' resizer='true' style='min-height:54px'>{{ remise.comment }}</textarea>
    </div>
</div>
<div class='clear'></div>


<br/>Liste des paiements en espèces à remettre ({{ lignes|length }} disponible{% if (lignes|length > 1) %}s{% endif %},
<span id='nbEspecesSel'></span>) :<br/>



{% set nbPages = (lignes|length / nbParPage)|round(0,'ceil') %}


{% if (nbPages> 1) %}
    <ul class='pagination' id='pagerListingRemisesEspeces'>
        {% for j in 1..nbPages %}
            {% set current_class = '' %}
            {% if j == 1 %}
                {% set current_class = 'active' %}
            {% endif %}
            <li class="{{ current_class }}" id='linkPagingEspeces_{{ j }}'>
                <a href='javascript:void(0)' onclick="displayPageListingRemiseEspeces('{{ j }}')">{{ j }}</a></li>
        {% endfor %}
    </ul>
{% endif %}

<div class='modal-footer'>
    <button type='button' class='btn btn-default btn-sm' data-dismiss='modal'>
        <span class='glyphicon glyphicons ban'></span> Fermer
    </button>
    <button type='button' class='btn btn-success btn-sm' onclick='saveRemiseEspeces()'>
        <span class='glyphicon glyphicon-ok'></span> Enregistrer
    </button>
</div>


<table id='tableRemiseEspeces' class='table table-striped table-hover table-condensed'>
    <thead>
    <tr>
        <th>
            <div class='checkbox checkbox-inline checkbox-primary sm'>
                <input type='checkbox' id='ckAllEspecesRemise' onclick='selectAllEspecesRemise()'/><label for='ckAllEspecesRemise'></label>
            </div>
        </th>

        <th>Objet du paiement</th>
        <th>Montant</th>
        <th>Date paiement</th>
    </tr>
    </thead>
    <tbody>

    {% set num_ligne = 1 %}
    {% for ligne in lignes %}
        {% set numPage = (num_ligne / nbParPage)|round(0,'ceil') %}
        {% set current_class = '' %}
        {% if numPage > 1 %}
            {% set current_class = 'hidden' %}
        {% endif %}
        {% set checked = false %}


        {% if ligne.type_ligne == 'facture' %}
            {% if ligne.remise == remise.id and ligne.remise != '' %}
                {% set checked = true %}
                {% set current_class = current_class ~ ' selectedRow' %}
            {% endif %}
            <tr numpage='{{ numPage }}' id='rowEspeces_{{ ligne.id }}' onclick="selectEspecesRemise('{{ ligne.id }}')" class='{{ current_class }}'>
                <td>
                    <div class='checkbox checkbox-inline checkbox-primary sm'>
                        <input {% if checked %}checked{% endif %} id='ckEspeces_{{ ligne.id }}' name='num_paiement[]' value='{{ ligne.id }}' type='checkbox'/>
                        <label for='ckEspeces_{{ ligne.id }}'></label>
                    </div>
                </td>
                <td>
                    {% for consultation in ligne.consultations %}
                        Consultation du {{ dateToText(consultation.date_consult) }} : {{ consultation.patient.prenom }} {{ consultation.patient.nom}}<br/>
                    {% endfor %}
                </td>
                <td>{{ ligne.montant }} {{ devise }}</td>
                <td>{{ dateToText(ligne.date_paiement) }}</td>
            </tr>
        {% endif %}


        {% if ligne.type_ligne == 'operation' %}
            {% if ligne.paiement_bordereau_especes == remise.id and ligne.paiement_bordereau_especes != '' %}
                {% set checked = true %}
                {% set current_class = current_class ~ ' selectedRow' %}
            {% endif %}
            <tr numpage='{{ numPage }}' id='rowEspeces_{{ ligne.id }}' onclick="selectEspecesRemise('{{ ligne.id }}')" class='{{ current_class }}'>
                <td>
                    <div class='checkbox checkbox-inline checkbox-primary sm'>
                        <input {% if checked %}checked{% endif %} id='ckEspeces_{{ ligne.id }}' name='num_operation[]' value='{{ ligne.id }}' type='checkbox'/>
                        <label for='ckEspeces_{{ ligne.id }}'></label>
                    </div>
                </td>
                <td>{{ ligne.nom }}</td>
                <td>{{ ligne.montant_total }} {{ devise }}</td>
                <td>{{ dateToText(ligne.date_operation) }}</td>
        {% endif %}


        {% set num_ligne = num_ligne + 1 %}
    {% endfor %}

    </tbody>

</table>